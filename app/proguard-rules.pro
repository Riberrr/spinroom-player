# Project-specific R8 rules. Add keep rules here when a library needs them (e.g. kotlinx.serialization in S2).

# Ktor (server) references JVM-only management classes that don't exist on Android.
-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean

# kotlinx.serialization: keep generated serializers of our own @Serializable classes (looked up reflectively via Companion.serializer()).
-keepattributes *Annotation*, InnerClasses, Signature, RuntimeVisibleAnnotations
-dontnote kotlinx.serialization.**
-keepclassmembers @kotlinx.serialization.Serializable class io.github.riberrr.spinroom.** {
    *** Companion;
    kotlinx.serialization.KSerializer serializer(...);
    static ** INSTANCE;
}
-keepclasseswithmembers class io.github.riberrr.spinroom.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class io.github.riberrr.spinroom.**$$serializer { *; }

# Ktor server (Sendspin listener): optional JVM-only/SLF4J bits missing on Android.
-dontwarn io.ktor.**
-dontwarn org.slf4j.**
-dontwarn org.slf4j.impl.StaticLoggerBinder

# Hilt/Dagger ship their own consumer rules; nothing extra needed beyond keeping entry points (generated by the plugin).
# OkHttp / Okio / Coil: consumer rules bundled.
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**

# Hilt resolves ViewModels by their (original) class name string; obfuscation made it fall back to a no-arg constructor
# and crash with "Cannot create an instance of class ...ItemMenuViewModel" on startup.
-keepnames @dagger.hilt.android.lifecycle.HiltViewModel class * extends androidx.lifecycle.ViewModel
-keepnames class io.github.riberrr.spinroom.** extends androidx.lifecycle.ViewModel
