<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only, temporary (S03): start/stop the Sendspin player without the S05 service. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Starts the player at process start when the toggle is on (default on). -->
        <provider
            android:name=".debug.SendspinDebugStarter"
            android:authorities="${applicationId}.sendspin-debug"
            android:exported="false" />

        <!-- adb shell am broadcast -n <pkg>/io.github.riberrr.spinroom.debug.SendspinDebugReceiver -a <pkg>.SENDSPIN_STOP -->
        <receiver
            android:name=".debug.SendspinDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.SENDSPIN_START" />
                <action android:name="${applicationId}.SENDSPIN_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
